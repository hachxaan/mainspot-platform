# ============================================================
# MainSpot platform — environment reference (dev only)
# Copy to .env to override defaults. NEVER commit a real .env.
# All values below are simulated/dev-only placeholders.
# ============================================================

# HTTP server
PORT=3000
APP_ENV=development

# PostgreSQL (defaults match docker-compose.yml dev values)
POSTGRES_USER=mainspot
POSTGRES_PASSWORD=mainspot_dev_password
POSTGRES_DB=mainspot
DATABASE_URL=postgres://mainspot:mainspot_dev_password@localhost:5432/mainspot

# Test database (created on the fly by scripts/test-prep.ts)
TEST_DATABASE_URL=postgres://mainspot:mainspot_dev_password@localhost:5432/mainspot_test

# Session/JWT — REQUIRED for the app service and for `npm start`.
# There is intentionally NO default secret (IR-02). Generate one and put it
# here (this file is a reference; never commit a real .env):
#   JWT_SECRET=$(openssl rand -hex 32)
# The app refuses to start without it (APP_ENV=test is the only exception and
# test code passes its own explicit test-only value).
JWT_SECRET=cambiar_antes_de_usar
JWT_TTL_MINUTES=60
SESSION_SOURCE=backoffice

# Login rate limiting (by IP + login; in-memory, per instance).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOCK_MS=60000

# Audit behaviour: fail_closed | fail_open
# fail_closed = sensitive actions are aborted if the audit write fails (contract: reliable or fail-closed).
AUDIT_MODE=fail_closed

# Log level: debug | info | warn | error  (invalid values abort startup)
LOG_LEVEL=info

# Evidence/output directory used by scripts (relative to repo root)
EVIDENCE_DIR=evidence

# ============================================================
# INC-002 — canal conversacional (DEC-016 + DEC-026)
# ============================================================

# Canal primario: telegram | simulated
# - telegram   → adaptador REAL (requiere TELEGRAM_BOT_TOKEN; fetch a Bot API).
# - simulated  → canal simulado funcional para E2E/piloto SIN credenciales
#                (DEC-026: modo simulado funcional).
# Sin TELEGRAM_BOT_TOKEN, el registro cae a SimulatedChannel aunque
# CHANNEL_PRIMARY=telegram (fail-safe, nunca llama a la API sin token).
CHANNEL_PRIMARY=simulated
TELEGRAM_BOT_TOKEN=
TELEGRAM_BASE_URL=https://api.telegram.org

# Preview/sandbox link (CAP-008, TENTATIVA): token aleatorio de alta entropía,
# almacenado SOLO como hash; alcance limitado a una propuesta; single-use.
# Expiración del enlace de vista previa:
PREVIEW_TOKEN_TTL_MINUTES=1440

# Rate limiting de aprobaciones sensibles (IP + operador + propuesta).
APPROVAL_RATE_LIMIT_MAX=10
APPROVAL_RATE_LIMIT_WINDOW_MS=60000
APPROVAL_RATE_LIMIT_LOCK_MS=30000

# ============================================================
# INC-003 — web administrable + dominio subdominio MainSpot (DEC-019/026)
# ============================================================

# Proveedor de dominios: simulated | hostinger
#   simulated → SimulatedHostinger (genera <slug>.sim.mainspot.local,
#               DNS + certificado simulados; E2E/piloto sin credenciales)
#   hostinger → implementación REAL opcional (requiere HOSTINGER_API_TOKEN)
# Sin credenciales Hostinger, el servicio SIEMPRE usa modo simulado (DEC-026).
DOMAIN_PROVIDER=simulated
HOSTINGER_API_BASE_URL=https://api.hostinger.com
HOSTINGER_API_TOKEN=

# Sufijo del subdominio simulado por cliente (modo simulado, DEC-019).
MAINSPOT_DOMAIN_SUFFIX=sim.mainspot.local

# DEV-E2E-04 (P3): dominio base de los sitios locales REALES por negocio (https://<slug>.<dominio>).
# Solo red de desarrollo: /etc/hosts + certificado de la CA local mkcert + vhost en el LXC webserver,
# provisionados por sitio con scripts/client-site-provision.sh <slug>. Nunca DNS público.
LOCAL_SITE_DOMAIN=mainspot.local.io

# ============================================================
# INC-004 — Google Business Profile + reputación (DEC-011/023/026)
# ============================================================

# Umbral de enrutamiento de reseñas a revisión humana (DEC-023):
# una reseña con calificación MENOR que REVIEW_THRESHOLD se sugiere/escala.
# Default 4 (<4 estrellas); el valor definitivo queda para investigación con
# datos (Q-013). Configurable por entorno.
REVIEW_THRESHOLD=4

# Proveedor de reseñas: simulated | google_business_profile
#   simulated → SimulatedReviews (dataset determinista por tenant; E2E/piloto
#               sin credenciales; respuesta pública simulada idempotente)
#   google_business_profile → conector por negocio; sin autorización devuelve bloqueo, NO simula.
REPUTATION_PROVIDER=simulated
# scripts/dev-panel.sh: activación deliberada, nunca por presencia de un token.
MAINSPOT_DEV_GOOGLE=simulated
# Clave base64 de 32 bytes para AES-256-GCM (generar fuera de Git, respaldar protegida).
CONNECTOR_TOKEN_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ============================================================
# INC-005 — Facebook publicaciones y Ads (DEC-017/026)
# ============================================================

# Proveedor social: simulated | meta
#   simulated → SimulatedMeta (página fija por tenant, publicaciones/ads
#               simulados deterministas e idempotentes; E2E sin credenciales)
#   meta → Graph API por Page/negocio; sin autorización devuelve bloqueo, NO simula.
# Campañas avanzadas e Instagram quedan fuera del alcance aprobado.
SOCIAL_PROVIDER=simulated
MAINSPOT_DEV_META=simulated
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_GRAPH_BASE_URL=https://graph.facebook.com
# Comprobación de cuenta publicitaria solo lectura; no autoriza gasto.
META_ADS_CHECK=off
SOCIAL_SCHEDULER=on
SOCIAL_SCHEDULER_INTERVAL_MS=15000
SOCIAL_SCHEDULER_TIMEZONE=America/Cancun

# ============================================================
# DEV-E2E-02 — Agente de atención, Telegram y alta asistida
# ============================================================

# Observador de reseñas de Google y comentarios de Facebook (sin navegador).
#   on  → corre dentro del servidor HTTP
#   off → el servidor no lo arranca; usar `node scripts/engagement-worker.ts`
ENGAGEMENT_WORKER=on
ENGAGEMENT_WORKER_INTERVAL_MS=15000
# Intervalo mínimo entre lecturas al proveedor por tenant y origen (backoff aparte).
ENGAGEMENT_POLL_INTERVAL_MS=60000
# Secreto del webhook de Telegram (cabecera X-Telegram-Bot-Api-Secret-Token, el mismo valor
# que se pasa a setWebhook; Telegram solo admite 1-256 caracteres A-Z a-z 0-9 _ -).
# OBLIGATORIO en TODO entorno para recibir updates, también en desarrollo: sin él el webhook
# responde 503 y no procesa nada; cabecera ausente o distinta → 401. El chat simulado del
# panel (/dev/simulator/telegram) no lo necesita.
TELEGRAM_WEBHOOK_SECRET=
# URL pública del panel (enlaces en avisos de Telegram e invitaciones). En desarrollo,
# scripts/dev-panel.sh usa por defecto el origen oficial https://app.mainspot.local.io.
PUBLIC_BASE_URL=http://localhost:3000

# ============================================================
# DEV-E2E-04 (P2) — Correo transaccional para recuperar contraseña
# ============================================================

# disabled (default): NO se envía correo; «¿Olvidaste tu contraseña?» responde igual de neutro,
#   registra mail.transport_disabled y la capacidad queda BLOCKED_EXTERNAL (nunca se simula envío).
# smtp: servidor SMTP con TLS obligatorio (465 implícito o STARTTLS requerido; sin texto claro).
# resend: API HTTP transaccional de Resend (https://resend.com) sobre HTTPS.
MAIL_TRANSPORT=disabled
# Remitente verificado en el proveedor, p. ej. "MainSpot <no-responder@tu-dominio>".
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Nunca se registra ni se audita.
SMTP_PASS=
# implicit | starttls (vacío ⇒ implicit si SMTP_PORT=465, si no starttls).
SMTP_SECURE=
# Opcional: PEM con una CA adicional (relé privado con CA propia, p. ej. mkcert). Vacío ⇒ CAs del sistema.
SMTP_CA_FILE=
# Solo con MAIL_TRANSPORT=resend. Nunca se registra ni se audita.
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com

# ============================================================
# INC-006 — Suscripciones, planes y límites (DEC-024)
# ============================================================

# Proveedor de pagos: simulated | stripe(TENTATIVA)
# DEC-024: el piloto NO cobra y NO usa procesador de pagos. 'simulated' siempre
# responde ok sin llamadas externas; los planes no tienen precio aprobado.
PAYMENT_PROVIDER=simulated

# ============================================================
# INC-007 — Analítica mínima + export ETL (DEC-025)
# ============================================================

# Retención (QS-0006, DEC-0021..0027): plazos fijados por decisión (no configurables)
# y ejecución automática diaria en el servidor; ver README §10.

# ============================================================
# APR-0002 — Jev como clasificador semántico (TypeSafe): disabled | shadow | primary
# ============================================================

# disabled (default): sin cliente ni salida de datos; decide el determinista.
# shadow: decide el determinista; Jev queda como evidencia (jev_classification).
# primary: Jev determina la clasificación cuando la última evaluación sintética
#   (npm run jev:evaluate) supera los umbrales (DEC-0031); si no, actúa como shadow.
# JEV_ENABLED y JEV_SHADOW_MODE ya no existen: si están definidas, el arranque falla.
JEV_MODE=disabled
# Proveedor explícito: typesafe. Cualquier otro valor aborta el arranque; no hay
# fallback ni cambio de proveedor ante fallos.
JEV_PROVIDER=
# Requerida con shadow/primary. Nunca se loguea, audita ni persiste.
TYPESAFE_API_KEY=
# Modelo solicitado (vacío ⇒ alias del proveedor, jev-latest). Cada fila guarda
# además el modelo versionado que respondió; el gate exige que esté evaluado.
JEV_MODEL=
# DEC-0019: solo datos sintéticos (único valor válido).
JEV_DATA_SCOPE=synthetic
# Requerida con shadow/primary: tenants con datos SOLO sintéticos. Solo el TEXTO
# de sus mensajes sale a api.typesafe.ai (sin ZDR asumido); el resto no sale.
JEV_SYNTHETIC_TENANTS=client_a,client_b
# DEC-0032: presupuesto diario en USD (0 < valor <= 1), por proceso y día UTC.
JEV_DAILY_BUDGET_USD=1
