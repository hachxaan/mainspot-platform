# ============================================================
# MainSpot platform — environment reference (dev only)
# Copy to .env to override defaults. NEVER commit a real .env.
# All values below are simulated/dev-only placeholders.
# ============================================================

# HTTP server
PORT=3000
APP_ENV=development

# PostgreSQL (defaults match docker-compose.yml dev values)
POSTGRES_USER=mainspot
POSTGRES_PASSWORD=mainspot_dev_password
POSTGRES_DB=mainspot
DATABASE_URL=postgres://mainspot:mainspot_dev_password@localhost:5432/mainspot

# Test database (created on the fly by scripts/test-prep.ts)
TEST_DATABASE_URL=postgres://mainspot:mainspot_dev_password@localhost:5432/mainspot_test

# Session/JWT — REQUIRED for the app service and for `npm start`.
# There is intentionally NO default secret (IR-02). Generate one and put it
# here (this file is a reference; never commit a real .env):
#   JWT_SECRET=$(openssl rand -hex 32)
# The app refuses to start without it (APP_ENV=test is the only exception and
# test code passes its own explicit test-only value).
JWT_SECRET=cambiar_antes_de_usar
JWT_TTL_MINUTES=60
SESSION_SOURCE=backoffice

# Login rate limiting (by IP + login; in-memory, per instance).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOCK_MS=60000

# Audit behaviour: fail_closed | fail_open
# fail_closed = sensitive actions are aborted if the audit write fails (contract: reliable or fail-closed).
AUDIT_MODE=fail_closed

# Log level: debug | info | warn | error  (invalid values abort startup)
LOG_LEVEL=info

# Evidence/output directory used by scripts (relative to repo root)
EVIDENCE_DIR=evidence

# ============================================================
# INC-002 — canal conversacional (DEC-016 + DEC-026)
# ============================================================

# Canal primario: telegram | simulated
# - telegram   → adaptador REAL (requiere TELEGRAM_BOT_TOKEN; fetch a Bot API).
# - simulated  → canal simulado funcional para E2E/piloto SIN credenciales
#                (DEC-026: modo simulado funcional).
# Sin TELEGRAM_BOT_TOKEN, el registro cae a SimulatedChannel aunque
# CHANNEL_PRIMARY=telegram (fail-safe, nunca llama a la API sin token).
CHANNEL_PRIMARY=simulated
TELEGRAM_BOT_TOKEN=
TELEGRAM_BASE_URL=https://api.telegram.org

# Preview/sandbox link (CAP-008, TENTATIVA): token aleatorio de alta entropía,
# almacenado SOLO como hash; alcance limitado a una propuesta; single-use.
# Expiración del enlace de vista previa:
PREVIEW_TOKEN_TTL_MINUTES=1440

# Rate limiting de aprobaciones sensibles (IP + operador + propuesta).
APPROVAL_RATE_LIMIT_MAX=10
APPROVAL_RATE_LIMIT_WINDOW_MS=60000
APPROVAL_RATE_LIMIT_LOCK_MS=30000

# ============================================================
# INC-003 — web administrable + dominio subdominio MainSpot (DEC-019/026)
# ============================================================

# Proveedor de dominios: simulated | hostinger
#   simulated → SimulatedHostinger (genera <slug>.sim.mainspot.local,
#               DNS + certificado simulados; E2E/piloto sin credenciales)
#   hostinger → implementación REAL opcional (requiere HOSTINGER_API_TOKEN)
# Sin credenciales Hostinger, el servicio SIEMPRE usa modo simulado (DEC-026).
DOMAIN_PROVIDER=simulated
HOSTINGER_API_BASE_URL=https://api.hostinger.com
HOSTINGER_API_TOKEN=

# Sufijo del subdominio simulado por cliente (modo simulado, DEC-019).
MAINSPOT_DOMAIN_SUFFIX=sim.mainspot.local
