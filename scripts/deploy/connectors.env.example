# =============================================================================
# MainSpot local — archivo PROTEGIDO de conectores reales (plantilla sin valores reales).
#
# Destino: ~/.config/mainspot/connectors.env  (propietario administrador, 0600).
# Lo lee scripts/dev-panel.sh (y por tanto mainspot-local.service). Si el archivo es legible
# por grupo/otros el arranque aborta (exit 78). Nunca va al repo.
#
#   ( umask 077; cp scripts/deploy/connectors.env.example ~/.config/mainspot/connectors.env )
#   chmod 0600 ~/.config/mainspot/connectors.env
#   sudo systemctl restart mainspot-local
# =============================================================================

# Facebook (páginas de negocio). simulated (por defecto) | real.
#   real ⇒ SOCIAL_PROVIDER=meta: «Conectar página de Facebook» usa la app de abajo y las
#   publicaciones aprobadas salen a la Page conectada de cada negocio. Exige CONNECTOR_TOKEN_KEY.
MAINSPOT_DEV_META=simulated

# App de Meta (developers.facebook.com → tu app → Configuración → Básica).
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business (opcional, recomendado por Meta): ID de la configuración creada en
# tu app → Facebook Login for Business → Configuraciones (token de usuario, con los permisos de la Page).
# Vacío ⇒ el diálogo pide los permisos con `scope`.
META_LOGIN_CONFIG_ID=
# URI pública de retorno de Facebook (la MISMA registrada en la app de Meta). meta.mainspot.io la publica el KVM y
# el túnel WireGuard hasta este equipo. Vacía ⇒ ${PUBLIC_BASE_URL}/api/connections/meta/callback.
META_OAUTH_REDIRECT_URI=https://meta.mainspot.io/api/connections/meta/callback
# Versión de Graph API (opcional; por defecto v26.0).
# META_GRAPH_VERSION=v26.0

# Clave que cifra (AES-256-GCM) los tokens de Facebook/Google de cada negocio: 32 bytes en base64.
# Generar UNA vez y conservar (si cambia, hay que volver a conectar las páginas):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CONNECTOR_TOKEN_KEY=

# Google Business Profile (simulated | real). Real exige GOOGLE_OAUTH_CLIENT_ID/SECRET y CONNECTOR_TOKEN_KEY.
MAINSPOT_DEV_GOOGLE=simulated
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
