# =============================================================================
# MainSpot LXD deploy — configuración NO secreta (documentación/ejemplo).
#
# Copia este archivo a ~/.config/mainspot/mainspot-deploy.env (opcional) para
# sobreescribir los defaults del script scripts/deploy/deploy-lxd.sh.
# Los SECRETOS NO van aquí: viven en ~/.config/mainspot/mainspot-secrets.env
# (0600), generados aleatoriamente en el primer deploy (POSTGRES_PASSWORD y
# JWT_SECRET). Este ejemplo nunca se comitea con valores reales.
# =============================================================================

# --- contenedores / imagen ---
# LXD_IMAGE=ubuntu:24.04
# DB_CONTAINER=mainspot-db
# APP_CONTAINER=mainspot-app
# APP_INSIDE_DIR=/opt/mainspot-platform
# SECRETS_DIR=$HOME/.config/mainspot

# --- base de datos ---
# DB_USER=mainspot
# DB_NAME=mainspot
# DB_TEST_NAME=mainspot_test
# PG_HBA_SUBNET=            # default: se deriva de la IP de mainspot-db (x.y.z.0/24)

# --- red / proxy ---
# APP_CONTAINER_PORT=3000   # puerto interno de la app (contra el que conecta el proxy)
# APP_HOST_LISTEN_PORT=3000 # puerto del host (listen del device proxy LXD)

# --- variables de entorno de la app (valores NO secretos; ver .env.example) ---
# APP_ENV=production
# LOG_LEVEL=info
# AUDIT_MODE=fail_closed
# JWT_TTL_MINUTES=60
# SESSION_SOURCE=backoffice
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_LOCK_MS=60000
# CHANNEL_PRIMARY=simulated
# TELEGRAM_BOT_TOKEN=
# PREVIEW_TOKEN_TTL_MINUTES=1440
# APPROVAL_RATE_LIMIT_MAX=10
# APPROVAL_RATE_LIMIT_WINDOW_MS=60000
# APPROVAL_RATE_LIMIT_LOCK_MS=30000
# DOMAIN_PROVIDER=simulated
# HOSTINGER_API_TOKEN=
# MAINSPOT_DOMAIN_SUFFIX=sim.mainspot.local
# REVIEW_THRESHOLD=4
# REPUTATION_PROVIDER=simulated
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_REDIRECT_URI=  # vacío → PUBLIC_BASE_URL/api/connections/google/callback
# PUBLIC_BASE_URL=https://app.tu-dominio-autorizado.example
# SOCIAL_PROVIDER=simulated
# META_APP_ID=
# META_GRAPH_VERSION=v26.0
# META_ADS_CHECK=off
# SOCIAL_SCHEDULER=on
# SOCIAL_SCHEDULER_INTERVAL_MS=15000
# SOCIAL_SCHEDULER_TIMEZONE=America/Cancun
# PAYMENT_PROVIDER=simulated
# --- Jev como clasificador (APR-0002; ver README §5.1). TYPESAFE_API_KEY NO va
# aquí: añádela a ~/.config/mainspot/mainspot-secrets.env. Solo tenants sintéticos.
# JEV_MODE=disabled          # disabled | shadow | primary
# JEV_PROVIDER=typesafe
# JEV_MODEL=jev-1.14.0       # versión fijada que respondió la evaluación del gate (no el alias jev-latest)
# JEV_DATA_SCOPE=synthetic
# JEV_SYNTHETIC_TENANTS=client_a,client_b
# JEV_DAILY_BUDGET_USD=1     # 0 < valor <= 1 (DEC-0032)

# Modo real requiere selección explícita, permisos y conexión del negocio; no cae a simulación.
# CONNECTOR_TOKEN_KEY, GOOGLE_OAUTH_CLIENT_SECRET y META_APP_SECRET van SOLO en
# ~/.config/mainspot/mainspot-secrets.env (0600), no en este archivo no secreto.
