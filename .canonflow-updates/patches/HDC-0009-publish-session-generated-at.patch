+# ---------------------------------------------------------------------------
+# publish-session: generated_at is the publication clock, never the future
+# ---------------------------------------------------------------------------
+
+def _prepared_qs(fixtures_dir: Path, **changes) -> dict:
+    doc = json.loads((fixtures_dir / "qs-v2-eight-types.questions.json").read_text())
+    doc.pop("question_session_id", None)
+    for key, value in changes.items():
+        if value is None:
+            doc.pop(key, None)
+        else:
+            doc[key] = value
+    return doc
+
+
+def _utc(offset_s: int) -> str:
+    import datetime as dt
+    moment = dt.datetime.now(dt.timezone.utc) + dt.timedelta(seconds=offset_s)
+    return moment.strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def test_publish_session_stamps_missing_generated_at(empty_project: Path, fixtures_dir: Path):
+    import datetime as dt
+    before = dt.datetime.now(dt.timezone.utc).replace(microsecond=0)
+    result = lifecycle.publish_session(empty_project, _prepared_qs(fixtures_dir, generated_at=None))
+    after = dt.datetime.now(dt.timezone.utc)
+    published = json.loads((empty_project / result["path"]).read_text())
+    stamped = published["generated_at"]
+    assert stamped.endswith("Z") and len(stamped) == 20  # RFC 3339 UTC, seconds
+    assert before <= dt.datetime.fromisoformat(stamped) <= after
+
+
+@pytest.mark.parametrize("offset_s", [-86400, 0, 60])
+def test_publish_session_accepts_past_and_skewed_generated_at(empty_project: Path, fixtures_dir: Path,
+                                                              offset_s: int):
+    value = _utc(offset_s)
+    result = lifecycle.publish_session(empty_project, _prepared_qs(fixtures_dir, generated_at=value))
+    assert json.loads((empty_project / result["path"]).read_text())["generated_at"] == value
+
+
+def test_publish_session_rejects_future_generated_at(empty_project: Path, fixtures_dir: Path):
+    """RUN-0006/QS-0009: a prepared timestamp minutes ahead of publication
+    distorted latest (§7.2 step 8); nothing may be written."""
+    with pytest.raises(lifecycle.LifecycleError) as exc:
+        lifecycle.publish_session(empty_project, _prepared_qs(fixtures_dir, generated_at=_utc(145)))
+    assert (exc.value.code, exc.value.status) == ("GENERATED_AT_FUTURE", 422)
+    assert not list(paths.sessions_dir(empty_project, "pending").iterdir())
+
+
+@pytest.mark.parametrize("value", ["2026-10-22 04:50:00", "2026-10-22T04:50:00+02:00",
+                                   "2026-13-40T04:50:00Z", "22/10/2026", 1761108600])
+def test_publish_session_rejects_non_rfc3339_utc_generated_at(empty_project: Path, fixtures_dir: Path,
+                                                              value):
+    with pytest.raises(lifecycle.LifecycleError) as exc:
+        lifecycle.publish_session(empty_project, _prepared_qs(fixtures_dir, generated_at=value))
+    assert (exc.value.code, exc.value.status) == ("GENERATED_AT_INVALID", 422)
+    assert not list(paths.sessions_dir(empty_project, "pending").iterdir())
