+@pytest.mark.parametrize("stage", ["ANSWERED", "INGESTED", "ARCHIVED"])
+def test_v2_initial_pending_declaration_is_not_a_state_conflict(answered_project: Path, stage: str):
+    """§5.2: a v2 QS always declares PENDING, its immutable initial state, so
+    answering, ingesting or archiving it must not raise DECLARED_STATE_CONFLICT
+    (legacy QS-0028 still does: test_qs0028_shows_ingested_with_folder_warning)."""
+    root = answered_project
+    if stage != "ANSWERED":
+        record = {
+            "schema_version": 2, "record_id": "DEC-0001", "kind": "decision",
+            "title": "fixture decision", "decision": "incremental", "owner": "Fixture Owner",
+            "decided_at": "2026-09-21", "source": "QS-0001/ANS-0001",
+            "source_ref": {"question_session_id": "QS-0001", "answer_session_id": "ANS-0001",
+                           "question_ids": ["Q-SINGLE"]},
+        }
+        lifecycle.publish_ingestion(root, {
+            "question_session_id": "QS-0001", "answer_session_id": "ANS-0001",
+            "actor": "agent-instrument", "records": [record],
+            "links": [{"from": "ANS-0001", "to": "QS-0001", "type": "DERIVES_FROM",
+                       "by": "Fixture Owner", "at": "2026-09-21T10:00:00Z"}],
+            "outcomes": [{"question_id": "Q-SINGLE", "record_ids": ["DEC-0001"]}]})
+    if stage == "ARCHIVED":
+        lifecycle.mark_session(root, {
+            "question_session_id": "QS-0001",
+            "event": {"state": "ARCHIVED", "actor": "agent-instrument", "reason": "completed"}})
+    rec = reconcile(root)
+    view = rec.sessions["QS-0001"]
+    assert (view.declared_state, view.effective_state) == ("PENDING", stage)
+    codes = {d.code for d in rec.diagnostics.values() if d.scope == "QS-0001"}
+    assert "DECLARED_STATE_CONFLICT" not in codes
+
+
+def test_v2_declaring_a_non_initial_state_still_warns(answered_project: Path):
+    """A v2 QS declaring anything but PENDING breaks §5.2: keep it visible."""
+    import hashlib
+    root = answered_project
+    qs_path = paths.sessions_dir(root, "pending") / "QS-0001.questions.json"
+    qs = json.loads(qs_path.read_text())
+    qs["state"] = "ARCHIVED"
+    qs_path.write_text(json.dumps(qs))
+    ans_path = paths.sessions_dir(root, "answered") / "QS-0001.answers.json"
+    ans = json.loads(ans_path.read_text())
+    ans["submission"]["question_sha256"] = "sha256:" + hashlib.sha256(qs_path.read_bytes()).hexdigest()
+    ans_path.write_text(json.dumps(ans))
+    rec = reconcile(root)
+    assert rec.sessions["QS-0001"].effective_state == "ANSWERED"
+    codes = {d.code for d in rec.diagnostics.values() if d.scope == "QS-0001"}
+    assert "DECLARED_STATE_CONFLICT" in codes
+
