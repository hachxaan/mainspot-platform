+.item-aside { display: flex; gap: 8px; align-items: center; justify-content: flex-end; flex-wrap: wrap; position: relative; z-index: 1; pointer-events: none; }
+.item-aside a, .item-aside button { pointer-events: auto; }
+.item .chev { color: var(--line-strong); }
