+.progress-bar { height: 100%; width: 0; background: var(--seal); border-radius: inherit; transition: width 200ms var(--ease); }
+.progress-label { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: var(--fs-sm); color: var(--ink-soft); margin-bottom: 8px; }
+.progress-label strong { color: var(--ink); font-size: var(--fs-lg); font-variant-numeric: tabular-nums; }
+
+.qnav { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
+.qnav a {
+  display: grid; grid-template-columns: 14px minmax(0, 1fr); gap: 10px; align-items: center;
+  padding: 7px 8px; border-radius: var(--r-sm); color: var(--ink-2); text-decoration: none; font-size: var(--fs-sm);
 }
+.qnav a:hover { background: var(--card-sunken); color: var(--ink); }
+.qnav .qnav-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.qnav-dot { width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--line-strong); background: var(--card); }
+.qnav a[data-status="done"] .qnav-dot { background: var(--seal); border-color: var(--seal); }
+.qnav a[data-status="attention"] .qnav-dot { background: var(--rec-soft); border-color: var(--rec); }
+.qnav a[data-status="error"] .qnav-dot { background: var(--danger); border-color: var(--danger); }
+.qnav a[data-status="optional"] .qnav-dot { border-style: dashed; }
 
+.save-state { display: inline-flex; gap: 6px; align-items: center; font-size: var(--fs-sm); color: var(--ink-soft); min-height: 20px; }
+.save-state::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--line-strong); }
+.save-state:empty::before { display: none; }
+.save-state[data-state="saving"] { color: var(--rec-ink); }
+.save-state[data-state="saving"]::before { background: var(--rec); }
+.save-state[data-state="saved"] { color: var(--seal-ink); }
+.save-state[data-state="saved"]::before { background: var(--seal); }
+.save-state[data-state="error"] { color: var(--danger-ink); }
+.save-state[data-state="error"]::before { background: var(--danger); }
+
+/* question card */
+.question {
+  border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--card);
+  padding: 20px 22px; display: grid; gap: 14px; scroll-margin-top: calc(var(--mast-h) + 20px);
+  transition: border-color 160ms var(--ease), box-shadow 160ms var(--ease);
+}
+.question + .question { margin-top: 16px; }
+.question[data-status="done"] { border-color: #C7E2D8; }
+.question.invalid, .question[data-status="error"] { border-color: var(--danger); box-shadow: 0 0 0 3px rgba(140, 47, 47, 0.08); }
+.question-head { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
+.question-id { font-family: var(--mono); font-size: var(--fs-xs); font-weight: 650; color: var(--ink-soft); }
+.question-title { font-size: var(--fs-lg); font-weight: 650; line-height: 1.35; overflow-wrap: anywhere; }
+.question-desc { color: var(--ink-2); margin: 0; overflow-wrap: anywhere; }
+.question-detail { font-size: var(--fs-md); color: var(--ink-2); }
+.why { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 10px; padding: 10px 12px; border-radius: var(--r-md);
+  background: var(--card-sunken); border-left: 3px solid var(--seal-light); font-size: var(--fs-md); color: var(--ink-2); }
+.why .icon { color: var(--seal); margin-top: 2px; }
+.why-label { font-weight: 650; color: var(--ink); margin-right: 4px; }
+
+fieldset.options { border: 0; margin: 0; padding: 0; min-width: 0; display: grid; gap: 8px; }
+fieldset.options > legend { padding: 0; margin-bottom: 8px; font-size: var(--fs-sm); font-weight: 600; color: var(--ink-soft); }
+.options--inline { grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
+.option {
+  display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 12px; align-items: start;
+  padding: 12px 14px; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--card);
+  cursor: pointer; transition: border-color 120ms var(--ease), background-color 120ms var(--ease), box-shadow 120ms var(--ease);
+}
+.option:hover { border-color: var(--ink-soft); background: var(--card-sunken); }
+.option > input { margin-top: 2px; }
+.option:has(input:checked), .option.is-checked { border-color: var(--seal); background: var(--seal-softer); box-shadow: inset 0 0 0 1px var(--seal); }
+.option:has(input:focus-visible) { box-shadow: var(--focus); border-color: var(--seal); }
+.option:has(input:disabled) { cursor: default; }
+.option:has(input:disabled):hover { border-color: var(--line); background: var(--card); }
+.option:has(input:disabled:checked) { border-color: var(--seal); background: var(--seal-softer); }
+.option-body { display: grid; gap: 4px; min-width: 0; }
+.option-label { font-weight: 600; color: var(--ink); display: flex; flex-wrap: wrap; gap: 6px 8px; align-items: center; overflow-wrap: anywhere; }
+.option-desc { font-size: var(--fs-md); color: var(--ink-2); overflow-wrap: anywhere; }
+.option-meta { display: grid; gap: 2px; font-size: var(--fs-sm); color: var(--ink-soft); margin-top: 2px; }
+.option-meta b { font-weight: 650; color: var(--ink-2); }
+.option--danger:has(input:checked) { border-color: var(--danger); background: var(--danger-softer); box-shadow: inset 0 0 0 1px var(--danger); }
+.option--danger > input { accent-color: var(--danger); }
+
+.binding { display: grid; gap: 6px; padding: 12px 14px; border-radius: var(--r-md); border: 1px dashed var(--line-strong); background: var(--card-sunken); }
+.binding-title { font-size: var(--fs-xs); font-weight: 650; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-mute); }
+
+.order-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; counter-reset: none; }
+.order-item {
+  display: grid; grid-template-columns: 32px minmax(0, 1fr) auto; gap: 12px; align-items: center;
+  padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--card);
+}
+.order-pos {
+  width: 32px; height: 32px; border-radius: var(--r-md); background: var(--seal-soft); color: var(--seal-ink);
+  display: inline-flex; align-items: center; justify-content: center; font-weight: 750; font-variant-numeric: tabular-nums;
+}
+.order-body { min-width: 0; display: grid; gap: 2px; }
+.order-label { font-weight: 600; overflow-wrap: anywhere; }
+.order-desc { font-size: var(--fs-sm); color: var(--ink-soft); overflow-wrap: anywhere; }
+.order-actions { display: flex; gap: 4px; }
+.order-item.is-moved { animation: moved 600ms var(--ease); }
+@keyframes moved { from { background: var(--seal-soft); } to { background: var(--card); } }
+
+.risk-fields { display: grid; grid-template-columns: minmax(160px, 220px) minmax(0, 1fr); gap: 14px; padding: 14px; border-radius: var(--r-md); background: var(--card-sunken); border: 1px solid var(--line-soft); }
+
+.comment-field { display: grid; gap: 6px; }
+
+/* summary (section 6) */
+.summary-list { list-style: none; margin: 0; padding: 0; display: grid; }
+.summary-row {
+  display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; gap: 4px 12px; align-items: start;
+  padding: 12px 0; border-top: 1px solid var(--line-soft);
+}
+.summary-row:first-child { border-top: 0; padding-top: 0; }
+.summary-row .icon { margin-top: 2px; }
+.summary-row[data-status="done"] .icon { color: var(--seal); }
+.summary-row[data-status="attention"] .icon { color: var(--rec); }
+.summary-row[data-status="missing"] .icon { color: var(--line-strong); }
+.summary-row[data-status="error"] .icon { color: var(--danger); }
+.summary-q { font-weight: 600; overflow-wrap: anywhere; }
+.summary-a { color: var(--ink-2); font-size: var(--fs-md); overflow-wrap: anywhere; white-space: pre-line; }
+.summary-note { color: var(--rec-ink); font-size: var(--fs-sm); }
+.summary-comment { color: var(--ink-soft); font-size: var(--fs-sm); border-left: 2px solid var(--line); padding-left: 10px; margin-top: 4px; white-space: pre-line; overflow-wrap: anywhere; }
+
+/* send (section 7) */
+.checklist { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
+.checklist li { display: flex; gap: 10px; align-items: flex-start; font-size: var(--fs-md); }
+.checklist li[data-ok="true"] .icon { color: var(--seal); }
+.checklist li[data-ok="false"] .icon { color: var(--rec); }
+.send-row { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
+.error-summary { display: grid; gap: 8px; }
+.error-summary ul { margin: 0; padding-left: 18px; display: grid; gap: 4px; }
+
+.success-panel { display: grid; gap: 12px; justify-items: start; }
+.success-icon { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--seal-soft); color: var(--seal); }
+.success-icon .icon { width: 24px; height: 24px; stroke-width: 2.2; }
+.ref-box { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; padding: 10px 12px; border-radius: var(--r-md); background: var(--card-sunken); border: 1px solid var(--line-soft); width: 100%; }
+.ref-box .path { flex: 1 1 16rem; min-width: 0; }
+.ws-success-title { font-size: var(--fs-lg); font-weight: 650; }
+.success-panel p { margin: 0; }
+
+/* guidance lists (sections 3 and 4), plain lists inside callouts */
+.ws-guide { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
+.ws-guide > li { display: grid; gap: 8px; padding: 12px 14px; border: 1px solid var(--line-soft); border-radius: var(--r-md); background: var(--card-sunken); min-width: 0; }
+.ws-guide-head { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; justify-content: space-between; }
+.ws-guide-link { font-weight: 650; overflow-wrap: anywhere; }
+.ws-guide-line { gap: 4px; }
+.ws-guide-opts { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
+.ws-guide-opts > li { display: grid; gap: 2px; min-width: 0; }
+.ws-plain-list { list-style: none; margin: 0; padding: 0; }
+.question-head .question-n { margin-left: auto; }
+.ws-summary-body { gap: 4px; min-width: 0; }
+.ws-order-confirm { padding: 10px 12px; border: 1px dashed var(--line-strong); border-radius: var(--r-md); }
+.ws-order-confirm:has(input:checked) { border-style: solid; border-color: var(--seal); background: var(--seal-softer); }
+.risk-fields > .field { align-content: start; }
+.ws-aside-cta .save-state:empty { display: none; }
+.workspace .stack-sm > p { margin: 0; }
+
+.mobile-bar { display: none; }
+
+/* -------------------------------------------------------------- traceability */
+.graph-wrap { overflow: auto; border: 1px solid var(--line-soft); border-radius: var(--r-md); background: var(--card-sunken); }
+svg.graph { width: 100%; height: auto; min-width: 560px; }
+svg.graph .edge { stroke: var(--line-strong); stroke-width: 1.5; fill: none; }
+svg.graph .edge--declared { stroke: var(--seal); }
+svg.graph .edge--inferred { stroke: var(--rec); stroke-dasharray: 5 4; }
+svg.graph .edge-label { font: 600 10px var(--font); fill: var(--ink-soft); paint-order: stroke; stroke: var(--card-sunken); stroke-width: 4px; stroke-linejoin: round; }
+svg.graph .node { cursor: pointer; }
+svg.graph .node rect { fill: var(--card); stroke: var(--line-strong); stroke-width: 1.5; }
+svg.graph .node text { font: 650 12px var(--mono); fill: var(--ink); }
+svg.graph .node--QS rect { fill: var(--rec-softer); stroke: var(--rec); }
+svg.graph .node--ANS rect { fill: var(--info-soft); stroke: var(--info); }
+svg.graph .node--DEC rect, svg.graph .node--APR rect, svg.graph .node--RSK rect { fill: var(--seal-softer); stroke: var(--seal); }
+svg.graph .node--center rect { stroke-width: 3; }
+svg.graph .node:hover rect, svg.graph .node:focus rect { stroke-width: 3; }
+svg.graph .node:focus { outline: none; }
+svg.graph .arrow { fill: var(--seal); }
+svg.graph .arrow--inferred { fill: var(--rec); }
+.graph-legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: var(--fs-sm); color: var(--ink-soft); }
+.legend-swatch { display: inline-block; width: 22px; height: 0; border-top: 2px solid var(--seal); vertical-align: middle; margin-right: 6px; }
+.legend-swatch--inferred { border-top: 2px dashed var(--rec); }
+.legend-node { display: inline-block; width: 12px; height: 12px; border-radius: 3px; vertical-align: -1px; margin-right: 6px; border: 1.5px solid; }
+.legend-node--QS { background: var(--rec-softer); border-color: var(--rec); }
+.legend-node--ANS { background: var(--info-soft); border-color: var(--info); }
+.legend-node--REC { background: var(--seal-softer); border-color: var(--seal); }
+
+/* ------------------------------------------------- detail pages / lists */
+.detail-layout { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: var(--gap); align-items: start; }
+.plain-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
+.plain-list > li { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: baseline; overflow-wrap: anywhere; min-width: 0; }
+.plain-list > li + li { border-top: 1px solid var(--line-soft); padding-top: 10px; }
+.edge-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
+.edge-list li { display: grid; grid-template-columns: 18px auto minmax(0, 1fr) auto; gap: 8px; align-items: center; font-size: var(--fs-sm); }
+.edge-dir { color: var(--ink-mute); display: inline-flex; }
+.edge-type { font-size: var(--fs-xs); font-weight: 650; color: var(--ink-soft); }
+.quote { margin: 0; padding: 4px 0 4px 16px; border-left: 3px solid var(--seal-light); color: var(--ink-2); font-size: var(--fs-base); }
+.pad { padding: 16px 20px; }
+.results-meta { padding: 0 20px 10px; min-height: 20px; }
+.card--flush > .card-header { padding: 16px 20px 0; margin-bottom: 12px; }
+.inbox-controls { display: grid; gap: 12px; padding: 16px 20px 12px; justify-items: start; }
+.toolbar--filters { width: 100%; }
+.toolbar--filters .select { width: auto; min-width: 170px; height: 40px; }
+.trace-form { display: grid; grid-template-columns: minmax(200px, 1.4fr) auto 110px auto; gap: 14px; align-items: end; }
+.trace-form .segmented { height: 40px; align-items: center; }
+
+/* ------------------------------------------------------------- responsive */
+@media (max-width: 1180px) {
+  :root { --rail-w: 76px; }
+  .rail-label, .rail-count, .rail-foot { display: none; }
+  .rail-link { justify-content: center; padding: 0; height: 44px; }
+  .rail-link[aria-current="page"]::before { left: -6px; }
+  .ws-layout { grid-template-columns: minmax(0, 1fr); }
+  .ws-aside { display: none; }
+  .mobile-bar {
+    display: flex; position: sticky; bottom: 0; z-index: 30; gap: 12px; align-items: center;
+    margin: 0 -24px -24px; padding: 12px 24px; background: rgba(255, 255, 255, 0.96);
+    border-top: 1px solid var(--line); box-shadow: 0 -4px 16px rgba(16, 24, 32, 0.06);
+  }
+  .mobile-bar .progress { flex: 1; }
+  .mobile-bar .mobile-count { font-size: var(--fs-sm); color: var(--ink-soft); white-space: nowrap; font-variant-numeric: tabular-nums; }
+  .detail-layout { grid-template-columns: minmax(0, 1fr); }
+}
 @media (max-width: 860px) {
-  .layout { grid-template-columns: 1fr; }
-  .rail { position: static; flex-direction: row; flex-wrap: wrap; }
+  :root { --mast-h: 56px; --gap: 16px; }
+  .masthead-inner { padding: 0 16px; gap: 10px; }
+  .brand-product, .brand-project, .gen-chip { display: none; }
+  .status-pill .status-text { display: none; }
+  .status-pill { padding: 0 9px; }
+  .layout { grid-template-columns: minmax(0, 1fr); padding: 0 16px 24px; gap: 16px; }
+  .rail { position: sticky; top: var(--mast-h); z-index: 30; margin: 0 -16px; padding: 0 8px; background: var(--paper); border-bottom: 1px solid var(--line); }
+  .rail-nav { flex-direction: row; overflow-x: auto; border: 0; box-shadow: none; background: transparent; border-radius: 0; padding: 6px 0; scrollbar-width: none; }
+  .rail-nav::-webkit-scrollbar { display: none; }
+  .rail-link { height: 38px; padding: 0 12px; gap: 8px; white-space: nowrap; }
+  .rail-label { display: inline; }
+  .rail-link[aria-current="page"]::before { left: 10px; right: 10px; top: auto; bottom: -6px; width: auto; height: 3px; border-radius: 3px 3px 0 0; }
+  .rail-icon { width: 17px; height: 17px; }
+  .page-title { font-size: var(--fs-2xl); }
+  .card:not(.card--flush) { padding: 16px; }
+  .card--flush .card-header { padding: 14px 16px 0; }
+  .item { padding: 12px 16px; grid-template-columns: minmax(0, 1fr); }
+  .item-aside { justify-content: flex-start; }
+  .grid-2, .grid-3 { grid-template-columns: minmax(0, 1fr); }
+  .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
+  .kpi { padding: 12px; }
+  .kpi-value { font-size: var(--fs-2xl); }
+  .question { padding: 16px; }
+  .risk-fields { grid-template-columns: minmax(0, 1fr); }
+  .mobile-bar { margin: 0 -16px -24px; padding: 10px 16px; }
+  .toasts { right: 12px; left: 12px; bottom: 12px; width: auto; }
+  .table th, .table td { padding: 10px 12px; }
+  .trace-form { grid-template-columns: minmax(0, 1fr); }
+  .toolbar--filters .select { flex: 1 1 140px; }
+  .inbox-controls { padding: 14px 16px 10px; }
+  .inbox-controls .segmented { width: 100%; }
+  .card--flush > .card-header { padding: 14px 16px 0; }
+  .pad { padding: 14px 16px; }
+  .results-meta { padding: 0 16px 10px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { transition: none !important; animation: none !important; scroll-behavior: auto !important; }
+}
+
+@media print {
+  .masthead, .rail, .mobile-bar, .ws-aside, .toasts, .skip-link { display: none !important; }
+  .layout { display: block; padding: 0; }
+  .card, .question { box-shadow: none; break-inside: avoid; }
 }
