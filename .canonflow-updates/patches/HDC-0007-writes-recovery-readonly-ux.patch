@@ -242,6 +242,31 @@ def test_preserved_snapshot_keeps_original_bytes(legacy_project: Path):
     assert snapshots[0].read_bytes() == original
 
 
+def test_writes_reenabled_once_external_index_write_is_preserved(manager_legacy: ProjectionManager, monkeypatch):
+    """§13: an index rewritten by another writer between the poll's preservation
+    and its completeness check (e.g. ``canonflow-hdc rebuild-index`` while the
+    console runs) blocks writes only until a later refresh preserves the bytes;
+    the console must not stay read-only until a restart."""
+    manager_legacy.refresh()
+    assert manager_legacy.writes_enabled is True
+    index = paths.state_dir(manager_legacy.project_root) / "index.json"
+    real_preserve = legacy.preserve_legacy_indexes
+
+    def preserve_then_external_write(root):
+        result = real_preserve(root)
+        index.write_bytes(index.read_bytes() + b"\n")  # lands after the capture
+        return result
+
+    monkeypatch.setattr(legacy, "preserve_legacy_indexes", preserve_then_external_write)
+    manager_legacy.refresh()
+    assert manager_legacy.writes_enabled is False  # unpreserved bytes: writes blocked
+
+    monkeypatch.setattr(legacy, "preserve_legacy_indexes", real_preserve)
+    manager_legacy.refresh()
+    assert legacy.preservation_complete(manager_legacy.project_root)
+    assert manager_legacy.writes_enabled is True
+
+
