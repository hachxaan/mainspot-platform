+# ---------------------------------------------------------------------------
+# compatibility views after ingestion/archive/publication (§7.1, §7.2 step 8, §13)
+# ---------------------------------------------------------------------------
+
+def _ingest_and_archive(root: Path) -> None:
+    record = {
+        "schema_version": 2, "record_id": "DEC-0001", "kind": "decision",
+        "title": "fixture decision", "decision": "incremental", "owner": "Fixture Owner",
+        "decided_at": "2026-09-21", "source": "QS-0001/ANS-0001",
+        "source_ref": {"question_session_id": "QS-0001", "answer_session_id": "ANS-0001",
+                       "question_ids": ["Q-SINGLE"]},
+    }
+    lifecycle.publish_ingestion(root, {
+        "question_session_id": "QS-0001", "answer_session_id": "ANS-0001",
+        "actor": "agent-instrument", "records": [record],
+        "links": [{"from": "ANS-0001", "to": "QS-0001", "type": "DERIVES_FROM",
+                   "by": "Fixture Owner", "at": "2026-09-21T10:00:00Z"}],
+        "outcomes": [{"question_id": "Q-SINGLE", "record_ids": ["DEC-0001"]}]})
+    lifecycle.mark_session(root, {
+        "question_session_id": "QS-0001",
+        "event": {"state": "ARCHIVED", "actor": "agent-instrument", "reason": "completed"}})
+
+
+def _views(root: Path) -> tuple[dict, dict]:
+    from canonflow_hdc import profiles
+    state_dir = paths.state_dir(root)
+    index = json.loads((state_dir / paths.STATE_INDEX).read_text())
+    _, errors = profiles.validate_document(index, "decision-state")
+    assert errors == []
+    return index, json.loads((state_dir / paths.STATE_LATEST).read_text())
+
+
+def _states(index: dict) -> dict:
+    return {s["question_session_id"]: s["state"] for s in index["sessions"]}
+
+
+def test_rebuild_index_with_an_unanswered_session(empty_project: Path, fixtures_dir: Path):
+    """Case A: a PENDING session without ANS no longer emits answered_at: None."""
+    doc = json.loads((fixtures_dir / "qs-v2-eight-types.questions.json").read_text())
+    lifecycle.publish_session(empty_project, doc)
+    result = lifecycle.rebuild_index(empty_project)
+    index, latest = _views(empty_project)
+    assert result["latest"] == "QS-0001"
+    assert index["sessions"][0]["state"] == "PENDING"
+    assert "answered_at" not in index["sessions"][0]
+    assert (latest["latest"], latest["state"]) == ("QS-0001", "PENDING")
+
+
+def test_views_follow_ingestion_and_archive(answered_project: Path):
+    """Case B: after publish-ingestion + mark-session ARCHIVED both views are
+    schema-valid and carry the effective state; rebuild-index keeps it."""
+    root = answered_project
+    _ingest_and_archive(root)
+    index, latest = _views(root)
+    assert _states(index) == {"QS-0001": "ARCHIVED"}
+    assert index["counters"] == {"qs": 1, "ans": 1, "dec": 1, "apr": 0, "rsk": 0}
+    assert (latest["latest"], latest["state"], latest["answer_session"]) == \
+        ("QS-0001", "ARCHIVED", "ANS-0001")
+    codes = {d.code for d in reconcile(root).diagnostics.values()}
+    assert not codes & {"INDEX_CORRUPT", "QS_FOLDER_MISMATCH", "DECLARED_STATE_CONFLICT"}
+    lifecycle.rebuild_index(root)
+    index, latest = _views(root)
+    assert _states(index) == {"QS-0001": "ARCHIVED"}
+    assert latest["state"] == "ARCHIVED"
+
