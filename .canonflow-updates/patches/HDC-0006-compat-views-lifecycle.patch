+def test_rebuild_index_never_lowers_preserved_counters(answered_project: Path):
+    root = answered_project
+    (paths.state_dir(root) / paths.STATE_INDEX).write_text(json.dumps({
+        "sessions": [], "counters": {"qs": 7, "ans": 7, "dec": 32, "apr": 2, "rsk": 0}}))
+    lifecycle.rebuild_index(root)
+    index, _latest = _views(root)
+    assert index["counters"] == {"qs": 7, "ans": 7, "dec": 32, "apr": 2, "rsk": 0}
+    assert _states(index) == {"QS-0001": "ANSWERED"}
