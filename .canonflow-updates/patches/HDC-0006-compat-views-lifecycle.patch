+def test_mark_session_archived_moves_qs_bytes_unchanged(answered_project: Path):
+    """Folder: ARCHIVED moves pending/ -> archived/ atomically, same bytes, so
+    the QS hash bound by ANS and lifecycle stays valid."""
+    root = answered_project
+    source = paths.sessions_dir(root, "pending") / "QS-0001.questions.json"
+    original = source.read_bytes()
+    _ingest_and_archive(root)
+    dest = paths.sessions_dir(root, "archived") / "QS-0001.questions.json"
+    assert not source.exists()
+    assert dest.read_bytes() == original
+    view = reconcile(root).sessions["QS-0001"]
+    assert (view.effective_state, view.evidence_status) == ("ARCHIVED", "confirmed")
+    assert view.qs_path.endswith("archived/QS-0001.questions.json")
+
