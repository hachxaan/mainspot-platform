+def test_publish_session_moves_latest_and_rebuild_needs_no_manual_preservation(
+        answered_project: Path, fixtures_dir: Path):
+    """Case C: publishing a newer QS updates latest.json; rebuild-index then
+    preserves the current bytes itself instead of PRESERVATION_REQUIRED."""
+    from canonflow_hdc import legacy
+    root = answered_project
+    _ingest_and_archive(root)
+    newer = json.loads((fixtures_dir / "qs-v2-eight-types.questions.json").read_text())
+    newer.pop("question_session_id")
+    newer.pop("generated_at")
+    published = lifecycle.publish_session(root, newer)
+    assert published["question_session_id"] == "QS-0002"
+    index, latest = _views(root)
+    assert (latest["latest"], latest["state"]) == ("QS-0002", "PENDING")
+    assert index["latest"] == "QS-0002"
+    assert _states(index) == {"QS-0001": "ARCHIVED", "QS-0002": "PENDING"}
+    # an external writer leaves unpreserved bytes behind: rebuild still works
+    index_path = paths.state_dir(root) / paths.STATE_INDEX
+    external = index_path.read_bytes() + b"\n"
+    index_path.write_bytes(external)
+    assert not legacy.preservation_complete(root)
+    result = lifecycle.rebuild_index(root)
+    import hashlib
+    snapshot = paths.legacy_dir(root) / f"index.json.{hashlib.sha256(external).hexdigest()}.json"
+    assert snapshot.read_bytes() == external  # preserved before regenerating (§13)
+    index, latest = _views(root)
+    assert (result["latest"], latest["latest"]) == ("QS-0002", "QS-0002")
+    assert index["counters"]["qs"] == 2
+
