@@ -0,0 +1,235 @@
+"""Compatibility views ``index.json``/``latest.json`` (definition §4, §7.2 step 8, §13).
+
+Both views are derived from the canonical artifacts through :func:`reconcile`
+and are written only after the current bytes are preserved under
+``decision-state/legacy/``. One derivation serves every writer:
+
+* the submission and the lifecycle instruments update only the affected index
+  entry (§13) and recompute ``latest``;
+* ``rebuild-index`` regenerates every entry.
+
+An entry's ``state`` is the effective state when the evidence chain resolves it
+(``confirmed``/``derived``); unresolved cases keep the state the index already
+declared, so a historical declaration is never downgraded to PENDING.
+``latest`` is the QS with the greatest valid ``generated_at``, QS id as
+tie-break. Counters never decrease against the preserved index.
+"""
+from __future__ import annotations
+
+import datetime as _dt
+import json
+from pathlib import Path
+
+from . import identity, paths, profiles
+from .canonicaljson import loads_strict
+
+COUNTER_KEYS = ("qs", "ans", "dec", "apr", "rsk")
+_RECORD_COUNTERS = {"DEC": "dec", "APR": "apr", "RSK": "rsk"}
+_RESOLVED_EVIDENCE = ("confirmed", "derived")
+_INDEX_STATES = ("PENDING", "ANSWERED", "INGESTED", "ARCHIVED", "CANCELLED", "EXPIRED")
+_MIN_TIME = _dt.datetime.min.replace(tzinfo=_dt.timezone.utc)
+
+
+class CompatViewError(Exception):
+    def __init__(self, code: str, message: str):
+        super().__init__(message)
+        self.code = code
+
+
+def _now() -> str:
+    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def parse_generated_at(value) -> _dt.datetime | None:
+    """A valid ``generated_at`` as an aware UTC datetime; ``None`` otherwise."""
+    if not isinstance(value, str):
+        return None
+    try:
+        when = _dt.datetime.fromisoformat(value)
+    except ValueError:
+        return None
+    if when.tzinfo is None:  # legacy precision without offset: read as UTC
+        when = when.replace(tzinfo=_dt.timezone.utc)
+    return when.astimezone(_dt.timezone.utc)
+
+
+def latest_session(rec) -> str | None:
+    """QS with the greatest valid generated_at, QS id as tie-break (§7.2 step 8)."""
+    best = None
+    for qs_id, view in rec.sessions.items():
+        key = (parse_generated_at(view.generated_at) or _MIN_TIME, qs_id)
+        if best is None or key > best:
+            best = key
+    return best[1] if best else None
+
+
+def index_state(view, previous: dict | None) -> str:
+    if view.evidence_status in _RESOLVED_EVIDENCE and view.effective_state in _INDEX_STATES:
+        return view.effective_state
+    declared = (previous or {}).get("state")
+    if declared in _INDEX_STATES:
+        return declared
+    return view.declared_state or view.effective_state
+
+
+def _entry(view, previous: dict | None) -> dict:
+    """Index entry for ``view``; unknown inherited keys of ``previous`` are kept."""
+    entry = {k: v for k, v in (previous or {}).items() if not k.startswith("_")}
+    entry["question_session_id"] = view.question_session_id
+    entry["state"] = index_state(view, previous)
+    if view.generated_at is not None:
+        entry["generated_at"] = view.generated_at
+    entry["records"] = list(view.record_ids)
+    optional = {
+        "answered_at": view.answered_at,
+        "session_label": view.session_label,
+        "answer_session_id": view.answer_session_id,
+        "diagnostics": list(view.diagnostic_ids) or None,
+    }
+    for key, value in optional.items():
+        if value:
+            entry[key] = value
+        else:
+            entry.pop(key, None)
+    if isinstance(entry.get("paths"), dict):  # real paths, never stale ones
+        observed = {"questions": view.qs_path, "answers": view.answers_path}
+        entry["paths"] = dict(entry["paths"]) | {k: v for k, v in observed.items() if v}
+    return entry
+
+
+def _evidence_counters(project_root: Path, rec) -> dict:
+    counters = dict.fromkeys(COUNTER_KEYS, 0)
+    for view in rec.sessions.values():
+        parsed = identity.parse_id(view.question_session_id)
+        if parsed:
+            counters["qs"] = max(counters["qs"], parsed[1])
+        parsed = identity.parse_id(view.answer_session_id) if view.answer_session_id else None
+        if parsed:
+            counters["ans"] = max(counters["ans"], parsed[1])
+    from .artifacts import inventory
+    for f in inventory(project_root):
+        if f.kind == "decision_record" and f.artifact_id:
+            parsed = identity.parse_id(f.artifact_id)
+            if parsed and parsed[0] in _RECORD_COUNTERS:
+                key = _RECORD_COUNTERS[parsed[0]]
+                counters[key] = max(counters[key], parsed[1])
+    return counters
+
+
+def _merged_counters(project_root: Path, rec, existing) -> dict:
+    """Evidence maxima, never below the counters the index already declared."""
+    counters = _evidence_counters(project_root, rec)
+    existing = existing if isinstance(existing, dict) else {}
+    for key in COUNTER_KEYS:
+        value = existing.get(key)
+        if isinstance(value, int) and not isinstance(value, bool):
+            counters[key] = max(counters[key], value)
+    return counters
+
+
+def _latest_doc(project_root: Path, rec, latest_id: str | None, entries: dict[str, dict]) -> dict | None:
+    if latest_id is None:
+        return None
+    view = rec.sessions[latest_id]
+    doc = {"latest": latest_id, "state": entries[latest_id]["state"]}
+    if view.answer_session_id:
+        doc["answer_session"] = view.answer_session_id
+        if view.answers_path:
+            doc["answers"] = view.answers_path
+        if view.answered_at:
+            doc["answered_at"] = view.answered_at
+    doc["updated_at"] = _now()
+    return doc
+
+
+def _load(path: Path) -> dict:
+    if not path.is_file():
+        return {}
+    try:
+        doc = loads_strict(path.read_bytes())
+    except Exception:
+        return {}
+    return doc if isinstance(doc, dict) else {}
+
+
+def _preserve(project_root: Path) -> None:
+    from .legacy import PreservationError, preserve_legacy_indexes
+    try:
+        preserve_legacy_indexes(project_root)  # pre-write bytes preserved (§13)
+    except PreservationError as exc:
+        raise CompatViewError("PRESERVATION_FAILED", str(exc)) from exc
+
+
+def _write(project_root: Path, index_doc: dict, latest_doc: dict | None) -> None:
+    state_dir = paths.state_dir(project_root)
+    state_dir.mkdir(parents=True, exist_ok=True)
+    paths.atomic_write_bytes(
+        state_dir / paths.STATE_INDEX,
+        (json.dumps(index_doc, ensure_ascii=False, indent=2) + "\n").encode("utf-8"))
+    if latest_doc is not None:
+        paths.atomic_write_bytes(
+            state_dir / paths.STATE_LATEST,
+            (json.dumps(latest_doc, ensure_ascii=False, indent=2) + "\n").encode("utf-8"))
+
+
+def update_entry(project_root: Path, qs_id: str, *, projection_version: str | None = None) -> list:
+    """Update only ``qs_id``'s index entry, the counters and ``latest`` (§13).
+
+    Other entries keep their bytes; if they were already invalid the index
+    stays diagnosed as INDEX_CORRUPT until ``rebuild-index``. Returns the
+    schema errors of the written index (empty when valid).
+    """
+    from .reconcile import reconcile
+    _preserve(project_root)
+    rec = reconcile(project_root)
+    doc = _load(paths.state_dir(project_root) / paths.STATE_INDEX)
+    sessions = [s for s in (doc.get("sessions") or []) if isinstance(s, dict)]
+    by_id = {s.get("question_session_id"): s for s in sessions}
+    if qs_id in rec.sessions:
+        fresh = _entry(rec.sessions[qs_id], by_id.get(qs_id))
+        if qs_id in by_id:
+            sessions[sessions.index(by_id[qs_id])] = fresh
+        else:
+            sessions.append(fresh)
+        by_id[qs_id] = fresh
+    doc["sessions"] = sessions
+    doc["counters"] = _merged_counters(project_root, rec, doc.get("counters"))
+    latest_id = latest_session(rec)
+    if latest_id is not None:
+        doc["latest"] = latest_id
+    if projection_version:
+        doc["projection_version"] = projection_version
+    entries = {k: v for k, v in by_id.items() if k in rec.sessions}
+    if latest_id is not None and latest_id not in entries:
+        entries[latest_id] = _entry(rec.sessions[latest_id], None)
+    _, errors = profiles.validate_document(doc, "decision-state")
+    _write(project_root, doc, _latest_doc(project_root, rec, latest_id, entries))
+    return errors
+
+
+def regenerate(project_root: Path, *, by: str) -> dict:
+    """Full regeneration of both views (CLI ``rebuild-index``, §7.1, §13)."""
+    from .reconcile import reconcile
+    _preserve(project_root)
+    rec = reconcile(project_root)
+    previous = _load(paths.state_dir(project_root) / paths.STATE_INDEX)
+    by_id = {s.get("question_session_id"): s for s in (previous.get("sessions") or [])
+             if isinstance(s, dict)}
+    entries = {qs_id: _entry(view, by_id.get(qs_id)) for qs_id, view in sorted(rec.sessions.items())}
+    latest_id = latest_session(rec)
+    doc = {k: v for k, v in previous.items()
+           if k not in ("sessions", "counters", "latest", "reconstructed")}
+    doc["sessions"] = list(entries.values())
+    doc["counters"] = _merged_counters(project_root, rec, previous.get("counters"))
+    if latest_id is not None:
+        doc["latest"] = latest_id
+    doc["reconstructed"] = {
+        "at": _now(), "by": by, "preserved": True,
+        "source": "artifacts+lifecycle+legacy-snapshots; state = effective state when the "
+                  "evidence chain resolves it, declared state otherwise",
+    }
+    _, errors = profiles.validate_document(doc, "decision-state")
+    if errors:
+        raise CompatViewError("INDEX_INVALID", f"rebuilt index failed its schema: {errors[:3]}")
+    _write(project_root, doc, _latest_doc(project_root, rec, latest_id, entries))
+    return {"sessions": len(entries), "counters": doc["counters"], "latest": latest_id}
