+def _archive_moves(project_root: Path, qs_id: str) -> list[tuple[Path, Path]]:
+    """pending/ copies of ``qs_id`` and their archived/ destination (same name)."""
+    pending = paths.sessions_dir(project_root, "pending")
+    archived = paths.sessions_dir(project_root, "archived")
+    moves = []
+    for path in art.find_qs_files(project_root):
+        if path.parent != pending:
+            continue
+        data = path.read_bytes()
+        try:
+            doc = loads_strict(data)
+        except Exception:
+            continue
+        if not isinstance(doc, dict) or doc.get("question_session_id") != qs_id:
+            continue
+        dest = archived / path.name
+        if dest.exists() and dest.read_bytes() != data:
+            raise LifecycleError("ARCHIVE_DESTINATION_EXISTS",
+                                 f"{dest.relative_to(project_root).as_posix()} exists with "
+                                 "different bytes; both files preserved for resolution", 409)
+        moves.append((path, dest))
+    return moves
+
+
+def _move_unchanged(source: Path, dest: Path) -> None:
+    """Atomic, byte-preserving move: hard link (never clobbers), then unlink."""
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    if dest.exists():  # identical copy already archived: drop the pending duplicate
+        source.unlink()
+    else:
+        os.link(source, dest)
+        paths.fsync_dir(dest.parent)
+        source.unlink()
+    paths.fsync_dir(source.parent)
+
+
+def _refresh_views(project_root: Path, qs_id: str) -> None:
+    """Keep index.json/latest.json current after a canonical write (§7.1, §13)."""
+    from .compat_views import CompatViewError, update_entry
+    try:
+        update_entry(project_root, qs_id)
+    except CompatViewError as exc:
+        raise LifecycleError(exc.code, f"{qs_id} was written, but the compatibility views "
+                                       f"were not: {exc}", 500) from exc
 
 
